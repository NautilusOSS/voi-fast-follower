# Copy to .env and fill in secrets. Never commit .env.

# --- Required ---
VOI_ALGOD_URL=http://host.docker.internal:4001
VOI_ALGOD_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
VOI_START_ROUND=latest

# --- Persistence ---
POSTGRES_USER=follower
POSTGRES_PASSWORD=change-me
POSTGRES_DB=voi_follower
ARCHIVE_SEGMENT_SIZE=1000

# --- Performance (production-safe defaults) ---
WORKERS=32
FETCH_WINDOW=128
COMMIT_BATCH_SIZE=10
COMMIT_FLUSH_INTERVAL=200ms
PG_INSERT_MODE=unnest
# PG_ASYNC_COMMIT must stay false in production

# --- Operations ---
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
METRICS_HOST_BIND=127.0.0.1
